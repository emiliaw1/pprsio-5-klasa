
using System;

class Program
{
    static Random random = new Random();

    static void Losuj(int[,] zestawy, int n)
    {
        for (int i = 0; i < n; i++)
        {
            int ile = 0;

            while (ile < 6)
            {
                int liczba = random.Next(1, 50);
                bool powtorzenie = false;

                for (int j = 0; j < ile; j++)
                {
                    if (zestawy[i, j] == liczba)
                    {
                        powtorzenie = true;
                    }
                }

                if (!powtorzenie)
                {
                    zestawy[i, ile] = liczba;
                    ile++;
                }
            }
        }
    }

    static void Wyswietl(int[,] zestawy, int n)
    {
        for (int i = 0; i < n; i++)
        {
            Console.Write("Zestaw " + (i + 1) + ": ");

            for (int j = 0; j < 6; j++)
            {
                Console.Write(zestawy[i, j] + " ");
            }

            Console.WriteLine();
        }
    }

    static void Main()
    {
        Console.Write("Podaj liczbe zestawow do wylosowania: ");
        int n = int.Parse(Console.ReadLine());

        int[,] zestawy = new int[n, 6];

        Losuj(zestawy, n);

        Console.WriteLine("\nWylosowane zestawy:");
        Wyswietl(zestawy, n);

        int[] wystapienia = new int[50];

        for (int i = 0; i < n; i++)
        {
            for (int j = 0; j < 6; j++)
            {
                wystapienia[zestawy[i, j]]++;
            }
        }

        Console.WriteLine("\nLiczba wystapien poszczegolnych liczb:");

        for (int i = 1; i <= 49; i++)
        {
            Console.WriteLine(i + " - " + wystapienia[i]);
        }

        Console.ReadKey();
    }
}
